<%- include('./partials/header') %>
 
<%
  // define your variables once
  let shippingFee = 500;     // FREE shipping
  let platformFee = 100;   // platform charges
%>


<% user.cart.forEach((item)=> { %>
<div class="w-full flex items-start px-20 py-20 gap-10">
  <div class="w-[30%] rounded-md overflow-hidden">
    <div class="w-full flex justify-center items-center h-80 bg-[<%=item.bgcolor%>]">
      <img
        class="h-[15rem]"
        src="data:image/jpeg;base64,<%=item.image.toString('base64') %>"
        alt=""
      />
    </div>
    <div class="w-full flex justify-between bg-[<%=item.panelcolor%>] px-5 py-4">
      <h3 class="text-2xl text-[<%=item.textcolor%>]"><%= item.name %></h3>
      <div class="flex items-center gap-2">
        <i
          class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-add-line"
        ></i>
        <div class="px-2 py-1 rounded-md bg-white text-black">01</div>
        <i
          class="w-7 h-7 bg-white flex rounded-full items-center justify-center ri-subtract-line"
        ></i>
      </div>
    </div>
    <div class="flex items-center border-t-2  bg-[<%=item.panelcolor%>] text-[<%=item.textcolor%>] justify-between px-5 py-3">
      <h4 class="text-lg">Net Total</h4>
      <h2 class="text-lg">₹ 1200</h2>
    </div>
  </div>
  <div class="w-[70%]">
    <h3 class="text-xl">Price Breakdown</h3>
    <div class="px-10 mt-5">
      <div class="flex mt-2">
        <h4 class="w-1/3">Total MRP</h4>
        <h4>RS <%=item.price%> </h4>
      </div>
      <div class="flex mt-2">
        <h4 class="w-1/3">Discount on MRP</h4>
        <h4><%= item.discount%></h4>
      </div>
      <div class="flex mt-2">
        <h4 class="w-1/3">Platform Fee</h4>
        <h4>RS <%=platformFee%> </h4>
      </div>
      <div class="flex mt-2">
        <h4 class="w-1/3">Shipping Fee</h4>
        <h4> <%= shippingFee %> </h4>
      </div>
    </div>
    <div class="w-full h-[1px] bg-black mt-10"></div>
    <div class="flex mt-5">
      <h3 class="w-1/3 text-xl">Total Amount</h3>
      <h3 class="font-semibold text-xl text-green-600">RS  <%= (item.price + platformFee + shippingFee) - (item.discount) %>  </h3>
    </div>
    <form action=""></form>
  </div>
</div>
<% }) %>

<%- include('./partials/footer') %>
